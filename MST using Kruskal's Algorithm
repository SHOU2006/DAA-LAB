#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

typedef struct {
    int u;
    int v;
    int w;
} Edge;

int findParent(int i, int parent[]) {
    if (parent[i] == i)
        return i;
    return parent[i] = findParent(parent[i], parent);
}

void unionSets(int u, int v, int parent[]) {
    int root_u = findParent(u, parent);
    int root_v = findParent(v, parent);
    parent[root_u] = root_v;
}

void kruskalMST (int **cost, int V) {
    int maxEdges = V * (V - 1) / 2;
    Edge edges[maxEdges];
    int edgeCount = 0;

    for (int i = 0; i < V; i++) {
        for (int j = i + 1; j < V; j++) {
            if (cost[i][j] != 9999 && cost[i][j] != 0) {
                edges[edgeCount].u = i;
                edges[edgeCount].v = j;
                edges[edgeCount].w = cost[i][j];
                edgeCount++;
            }
        }
    }

    for (int i = 0; i < edgeCount - 1; i++) {
        for (int j = 0; j < edgeCount - i - 1; j++) {
            if (edges[j].w > edges[j + 1].w) {
                Edge temp = edges[j];
                edges[j] = edges[j + 1];
                edges[j + 1] = temp;
            }
        }
    }

    
    int parent[V];
    for (int i = 0; i < V; i++) {
        parent[i] = i;
    }

    int minCost = 0;
    int count = 0;

    
    for (int i = 0; i < edgeCount && count < V - 1; i++) {
        int u = edges[i].u;
        int v = edges[i].v;
        int w = edges[i].w;

        int root_u = findParent(u, parent);
        int root_v = findParent(v, parent);

        
        if (root_u != root_v) {
            printf("Edge %d:(%d, %d) cost:%d\n", count, u, v, w);
            minCost += w;
            unionSets(u, v, parent);
            count++;
        }
    }

    
    printf("Minimum cost= %d\n", minCost);
}

int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
